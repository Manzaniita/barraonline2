# ==============================================================================
# BARRAONLINE — VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Para correr en local o en Vercel, solo necesitas configurar estas secciones:

# ------------------------------------------------------------------------------
# 1. ACCESO DEL ADMINISTRADOR (Tu cuenta de control)
# ------------------------------------------------------------------------------
# Tu correo de Gmail y la clave con la que vas a ingresar al panel /admin/login
SUPERADMIN_INITIAL_EMAIL=xjoacovidal@gmail.com
SUPERADMIN_INITIAL_PASSWORD=TuClaveAdminSegura2026!

# ------------------------------------------------------------------------------
# 2. GOOGLE OAUTH 2.0 (Para el inicio de sesión con Google)
# ------------------------------------------------------------------------------
# Se consiguen gratis en Google Cloud Console (APIs & Services > Credentials):
GOOGLE_CLIENT_ID=tu-id-de-cliente.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-secreto-de-cliente

# ------------------------------------------------------------------------------
# 3. BASE DE DATOS POSTGRESQL (Para producción en Vercel)
# ------------------------------------------------------------------------------
# En local podés dejarlo VACÍO (el sistema usa base de datos interna automática).
# En Vercel, pegá la URL de tu base de datos PostgreSQL (Neon, Supabase, etc.):
DATABASE_URL=

# ------------------------------------------------------------------------------
# 4. CONFIGURACIONES OPCIONALES (Tienen valores por defecto automáticos)
# ------------------------------------------------------------------------------
# URL pública de tu app. En Vercel se detecta automáticamente si no la ponés.
# NEXT_PUBLIC_APP_URL=https://barraonline.com.ar

# Clave secreta para firmar cookies de sesión (ya tiene un valor por defecto si no lo ponés):
# SESSION_HMAC_SECRET=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855

# NOTA SOBRE MERCADO PAGO:
# No necesitas configurar variables globales de Mercado Pago aquí.
# Cada boliche conecta su propia cuenta de Mercado Pago de forma independiente
# directamente desde su panel de administración.
