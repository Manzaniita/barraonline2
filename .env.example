# ==============================================================================
# BARRAONLINE.COM.AR — VARIABLES DE ENTORNO (.env.example)
# ==============================================================================

# 1. Dominio Raíz y Entorno
NODE_ENV=development
NEXT_PUBLIC_ROOT_DOMAIN=barraonline.com.ar
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. Base de Datos PostgreSQL 16
# Si DATABASE_URL se deja vacío en desarrollo local, se levanta automáticamente
# una instancia PostgreSQL 16 embebida (PGlite) con RLS forzado y datos semilla.
DATABASE_URL=

# 3. Criptografía y Bóveda de Credenciales (32 bytes en hex = 64 caracteres)
MP_CREDENTIALS_MASTER_KEY_V1=9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08
SESSION_HMAC_SECRET=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855

# 4. Mercado Pago Argentina — Integración OAuth de Terceros
MP_APP_CLIENT_ID=1234567890123456
MP_APP_CLIENT_SECRET=mp_client_secret_placeholder
MP_OAUTH_REDIRECT_URI=https://barraonline.com.ar/api/webhooks/mp/oauth/callback
MP_WEBHOOK_SECRET=mp_webhook_hmac_secret_placeholder

# 5. Google OAuth 2.0 / OIDC
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://barraonline.com.ar/api/auth/google/callback
